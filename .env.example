# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# Optional: use a supported Gemini model for chat and OCR.
GEMINI_MODEL="gemini-2.5-flash"

# Email notifications (required to deliver real approval emails).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Firebase Admin Service Account Credentials (Render / Production)
FIREBASE_PROJECT_ID=smart-admission-2b3df
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

